{
  "cleanUrls": true,
  "trailingSlash": false,
  "routes": [
    { "src": "^/$", "dest": "/index.html" },
    { "src": "^/panel$", "dest": "/panel.html" },
    { "src": "^/panel.html$", "dest": "/panel.html" },
    { "src": "^/pages/(.*)$", "dest": "/pages/$1" },
    { "src": "^/assets/(.*)$", "dest": "/assets/$1" },
    { "src": "^/berita/(.*)$", "dest": "/berita/$1" },
    { "src": "^/js/(.*)$", "dest": "/js/$1" },
    { "src": "^/uploads/(.*)$", "dest": "/uploads/$1" },
    { "src": "^/api/(.*)$", "dest": "/api/$1" }
  ]
}
